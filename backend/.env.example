# Research Reader Environment Configuration Template
# ENVIRONMENT: 'prod' (default: uses cloud API key path) | 'local' (uses local Ollama)
ENVIRONMENT=prod

# Show verbose 'Reason:' sections in AI outputs (default: false hides them and logs to console)
SHOW_AI_REASONS=false

# Database Configuration
DATABASE_URL=sqlite:///storage/reader.db

# Security & Admin
SECRET_KEY=change-this-in-production-to-a-random-secret
ADMIN_EMAILS=admin@example.com

# Cloud AI Provider API Keys (optional server-side defaults / testing)
# Users can also supply their keys directly in the web app UI
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Local Ollama URL
OLLAMA_BASE_URL=http://localhost:11434
